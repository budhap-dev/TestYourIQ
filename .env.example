# Postgres connection string.
#   Neon (production, or a Neon dev branch locally):
#     postgres://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
#   Local Postgres:
#     postgres://postgres:postgres@localhost:5432/uniqo
# Leave empty during local development to use a temporary in-memory store instead.
DATABASE_URL=

# Secret for signing test-taker cookies and encrypting item tokens. At least 32 characters;
# required in production. Generate one with: openssl rand -base64 48
SESSION_SECRET=
